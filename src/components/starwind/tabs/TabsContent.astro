---
import type { HTMLAttributes } from "astro/types";
import { tv } from "tailwind-variants";

interface Props extends Omit<
  HTMLAttributes<"div">,
  "id" | "role" | "tabindex" | "hidden"
> {
  value: string;
  /** Keep the page's prose spacing inside the panel (for text-heavy panels). */
  proseSpacing?: boolean;
}

export const tabsContent = tv({
  base: "mt-4 focus-visible:outline-2 focus-visible:outline-offset-2",
  variants: {
    proseSpacing: { false: "**:my-0", true: "" },
  },
  defaultVariants: { proseSpacing: false },
});

const { value, proseSpacing, class: className, ...rest } = Astro.props;
---

<div
  class={tabsContent({ proseSpacing, class: className })}
  data-slot="tabs-content"
  data-tabs-content
  data-value={value}
  data-state="inactive"
  role="tabpanel"
  tabindex="0"
  hidden
  {...rest}
>
  <slot />
</div>
